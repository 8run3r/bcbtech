# Client-side env (these end up in the bundle — never put secrets here)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Server-side secrets live in Supabase Dashboard → Edge Functions → Secrets:
#   ANTHROPIC_API_KEY, RESEND_API_KEY, SENDGRID_API_KEY, SENDGRID_FROM_EMAIL,
#   SLACK_WEBHOOK_URL, DISCORD_WEBHOOK_URL,
#   INSTAGRAM_ACCESS_TOKEN, INSTAGRAM_USER_ID,
#   LINKEDIN_ACCESS_TOKEN, LINKEDIN_ORG_ID,
#   FACEBOOK_PAGE_ID, FACEBOOK_ACCESS_TOKEN,
#   N8N_WEBHOOK_URL, N8N_API_KEY,
#   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
#   NOTIFY_EMAIL
# Never commit these. Never expose them with VITE_ prefix.
